# Production settings. infra/install.sh writes infra/prod/.env (mode 600) from this file.
# Never commit the real .env or infra/prod/backup.key.

# Public address: a domain for HTTPS (pharmacy.example.com), or ":80" for a drill.
SITE_ADDRESS=pharmacy.example.com
SITE_HOST=pharmacy.example.com
SITE_ORIGIN=https://pharmacy.example.com
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=owner@example.com

POSTGRES_DB=raff
POSTGRES_USER=raff
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me
# The organization this server serves (fixed for the life of the data).
SINGLE_ORG_ID=

# What "/" shows: "store" (the pharmacy's shop, the default for a pharmacy's own install) or
# "marketing" (Raff's product page, with the shop at /shop; for the public Raff site).
RAFF_ROOT=store

# Days a bank-transfer receipt photo is kept after its order is completed or cancelled.
RAFF_RECEIPT_RETENTION_DAYS=90

# Image tag being run, and the release name shown by /api/v1/health/.
RAFF_TAG=current
RAFF_VERSION=dev
GUNICORN_WORKERS=3

# Backups: where encrypted archives are kept, how many, and an optional off-site copy
# (rsync target like user@host:/backups/raff, or rclone:remote:path).
RAFF_BACKUP_DIR=/var/backups/raff
RAFF_BACKUP_KEEP=14
RAFF_BACKUP_REMOTE=

# Optional: license verification key and Telegram alerts for new store orders.
RAFF_LICENSE_PUBLIC_KEY=
RAFF_TELEGRAM_BOT_TOKEN=

# Only on a server where another web server already owns ports 80 and 443 (shared-host.md):
# publish Raff's own proxy on loopback and trust that web server's forwarded headers.
# RAFF_BIND=127.0.0.1
# RAFF_HTTP_PORT=8400
# RAFF_HTTPS_PORT=8443
# RAFF_TRUSTED_PROXIES=172.16.0.0/12
