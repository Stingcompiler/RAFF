# Reverse proxy and automatic HTTPS (Let's Encrypt) for the pharmacy's domain.
# SITE_ADDRESS is the domain (HTTPS) or ":80" for a plain-HTTP drill on a test machine.
{
	email {$ACME_EMAIL:admin@localhost}

	# Behind another proxy (shared server) its X-Forwarded-* headers are believed, so Django
	# sees https and the real client address. Default: nobody is trusted.
	servers {
		trusted_proxies static {$RAFF_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy frontend:3000
	}
}
